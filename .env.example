# Copy to `.env` and fill in your own values. NEVER commit the real `.env`.
#
# In production / CI, export these as real environment variables instead of
# using a file. Real environment variables always win over `.env`.

# --- LLM / VLM provider (OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Models: `deepseek-flash` supports text + image input (used as the VLM).
SKIM_LLM_MODEL=deepseek-flash
SKIM_VLM_MODEL=deepseek-flash

# --- Network ---
# Outbound proxy (this machine reaches the internet through 127.0.0.1:7892).
# Leave empty to disable.
SKIM_PROXY=http://127.0.0.1:7892

# --- Engine tuning (optional) ---
SKIM_DATA_DIR=data
SKIM_WHISPER_MODEL=small
SKIM_WHISPER_DEVICE=cpu
SKIM_WHISPER_COMPUTE_TYPE=int8
SKIM_LOG_LEVEL=INFO